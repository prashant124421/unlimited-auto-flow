{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "UNLIMITED AUTO FLOW",
  "version": "1.6.4",
  "description": "Automate bulk image & video generation on Google Flow — queue your prompts to create and auto-download them all in the background.",
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://us-central1-tryaitoday-automator.cloudfunctions.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "UNLIMITED AUTO FLOW",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["recap-capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["vendor/wm-detect.js", "wm.js", "flow-inject.js"],
      "css": ["flow-inject.css"],
      "run_at": "document_idle"
    }
  ]
}
